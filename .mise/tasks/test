#!/usr/bin/env bash
#MISE description="Run Bun and BATS tests"
#MISE dir="{{config_root}}"
#USAGE arg "[args]" default="" var=#true help="Optional suite (bun or bats), followed by suite arguments"
#USAGE example "mise run test" header="Run both suites"
#USAGE example "mise run test bun" header="Run Bun tests"
#USAGE example "mise run test bats test/pre-commit.bats" header="Run one BATS suite"
#USAGE example "mise run test bats --filter lifecycle" header="Filter BATS tests by name"
#USAGE example "mise run test bats --jobs 1" header="Run BATS serially for debugging"
set -euo pipefail

case "${1:-all}" in
  all)
    [ "$#" -eq 0 ] || {
      printf 'test: the all suite does not accept arguments; choose bun or bats\n' >&2
      exit 2
    }
    bun test "$MISE_CONFIG_ROOT/src"
    ;;
  bun)
    shift
    exec bun test "$MISE_CONFIG_ROOT/src" "$@"
    ;;
  bats)
    shift
    ;;
  *)
    printf 'test: unknown suite %q; expected bun or bats\n' "$1" >&2
    exit 2
    ;;
esac

export BATS_DEFAULT_TEST_TARGET="$MISE_CONFIG_ROOT/test"
export BATS_NUMBER_OF_PARALLEL_JOBS="${BATS_NUMBER_OF_PARALLEL_JOBS:-4}"
export BATS_PARALLEL_BINARY_NAME="${BATS_PARALLEL_BINARY_NAME:-rush}"

exec bats --print-output-on-failure "$@"
